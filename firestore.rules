rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Business the requesting user belongs to (from their users/{uid} doc)
    function myBusinessId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId;
    }

    // Users: can create only their own doc; any authenticated user can read (needed for team queries)
    // Update own doc (businessId and role immutable); business owner can update role of team members
    match /users/{userId} {
      allow create: if false; // users docs are created only by the createBusinessForSignup and registerInviteSignup Cloud Functions (Admin SDK, which bypasses rules); no client creates a users doc
      // Self-read FIRST and independent of myBusinessId(): during signup the users doc doesn't exist yet
      // (onAuthStateChanged fires before the server creates it), and dereferencing a missing doc in rules
      // errors (= deny), so the self clause must short-circuit before any myBusinessId() call.
      allow get: if request.auth != null && (
        request.auth.uid == userId
        || request.auth.token.email == "promisetrackermvp@gmail.com"
        || resource.data.businessId == myBusinessId()
      );
      allow list: if request.auth != null && (
        request.auth.token.email == "promisetrackermvp@gmail.com"
        || resource.data.businessId == myBusinessId()
      );
      // Owner-removes-member only; self-delete goes through the deleteAccount Cloud Function (Admin SDK)
      allow delete: if request.auth != null
        && resource.data.businessId != null
        && get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerId == request.auth.uid;
      allow update: if request.auth != null && (
        // Self-update: businessId, role, and emailVerified are immutable
        (request.auth.uid == userId &&
         request.resource.data.businessId == resource.data.businessId &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.get('emailVerified', null) == resource.data.get('emailVerified', null)) ||
        // Business owner can update only the role field for members in their business (cannot assign 'owner')
        (resource.data.businessId != null &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) &&
         request.resource.data.role in ['manager','receptionist','tech'] &&
         get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerId == request.auth.uid)
      );
    }

    // Business docs: only members of that business can read/write
    match /businesses/{businessId} {
      allow get: if request.auth != null && (
        resource.data.ownerId == request.auth.uid
        || request.auth.token.email == "promisetrackermvp@gmail.com"
        || businessId == myBusinessId()
      );
      allow list: if false;
      allow create: if false; // created only by createBusinessForSignup Cloud Function (Admin SDK)
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','timezone','endOfDayEnabled','endOfDayTime','timeFormat']);
      allow delete: if false; // never delete businesses from client
    }

    // Promises: only members of the same business can read/write; businessId is immutable
    match /promises/{promiseId} {
      allow read:   if request.auth != null && resource.data.businessId == myBusinessId();
      allow create: if request.auth != null && request.resource.data.businessId == myBusinessId();
      allow update: if request.auth != null
                    && resource.data.businessId == myBusinessId()
                    && request.resource.data.businessId == resource.data.businessId;
      allow delete: if request.auth != null && resource.data.businessId == myBusinessId();
    }

    // Contacts: auto-created from SMS promise logging; scoped to the owning business; businessId is immutable
    match /contacts/{contactId} {
      allow read:   if request.auth != null && resource.data.businessId == myBusinessId();
      allow create: if request.auth != null && request.resource.data.businessId == myBusinessId();
      allow update: if request.auth != null
                    && resource.data.businessId == myBusinessId()
                    && request.resource.data.businessId == resource.data.businessId;
      allow delete: if request.auth != null && resource.data.businessId == myBusinessId();
    }

    // Invites: get-by-ID stays open (invitee reads the invite while unauthenticated before signup);
    // list/create scoped to the requester's business; update is only the invitee's status flip
    match /invites/{inviteId} {
      allow get: if true; // by-ID only; invite IDs are unguessable auto-IDs (link secrecy). Needed because the invitee reads the invite while UNAUTHENTICATED before signup.
      allow list: if request.auth != null && resource.data.businessId == myBusinessId();
      allow create: if request.auth != null && request.resource.data.businessId == myBusinessId() && request.resource.data.role in ['manager','receptionist','tech'];
      allow update: if request.auth != null
                    && resource.data.businessId == myBusinessId()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status == 'accepted';
      allow delete: if false; // no client code deletes invites
    }

    // Fingerprints: fully server-only — all access via Cloud Functions (Admin SDK); no client reads or writes
    match /fingerprints/{docId} {
      allow create: if false; // created only by createBusinessForSignup / registerInviteSignup Cloud Functions (Admin SDK)
      allow read: if false; // read only by Cloud Functions (Admin SDK); no client path reads this collection
      allow update, delete: if false;
    }

    // Registered phones: same as fingerprints
    match /registeredPhones/{docId} {
      allow create: if false; // created only by createBusinessForSignup Cloud Function (Admin SDK)
      allow read: if false; // read only by Cloud Functions (Admin SDK); no client path reads this collection
      allow update, delete: if false;
    }

    match /verificationCodes/{docId} {
      allow read, create, update, delete: if false; // server-only: sendVerificationCode writes, verifyEmailCode reads/deletes (both Admin SDK)
    }

    // Affiliates: read-only from client (docs created manually in Firebase console)
    match /affiliates/{affiliateId} {
      allow read: if request.auth != null && request.auth.token.email == "promisetrackermvp@gmail.com";
      allow write: if false;
    }

    // Commission events: created by Cloud Functions (bypasses rules); admin can update to mark as paid
    match /commissionEvents/{eventId} {
      allow read: if request.auth != null && request.auth.token.email == "promisetrackermvp@gmail.com";
      allow create: if false;
      allow update: if request.auth != null && request.auth.token.email == "promisetrackermvp@gmail.com";
      allow delete: if false;
    }
  }
}
